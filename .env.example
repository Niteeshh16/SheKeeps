# Server
PORT=5000
SERVER_ADDRESS=127.0.0.1
AUTH_BYPASS=false

# Database (use a JDBC URL if DATABASE_URL is set)
DATABASE_URL=jdbc:postgresql://localhost:5432/shekeeps_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shekeeps_db

# Set both to different random values (minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_of_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_random_refresh_secret_of_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS and cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
